# ZEINER Electronica - configuracion prudente para Apache/cPanel
# Revisar en staging antes de publicar en produccion.

# Evita listado de directorios si falta un index.
Options -Indexes

# Pagina 404 personalizada.
ErrorDocument 404 /404.html

# Pagina comun para accesos bloqueados.
ErrorDocument 403 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Forzar HTTPS cuando el certificado SSL ya este activo en cPanel/AutoSSL.
  # La excepcion local evita molestias en entornos de prueba.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Bloquear archivos ocultos, sin bloquear .well-known usado por SSL/validaciones.
  RewriteRule (^|/)\.(?!well-known/) - [F]

  # Bloquear carpetas internas si por error se suben a public_html.
  RewriteRule ^(storage|docs)(/|$) - [F]
</IfModule>

# Bloqueo de archivos de desarrollo, respaldos, fuentes o datos sensibles.
<FilesMatch "(^composer\.(json|lock)$|^package(-lock)?\.json$|^vite\.config\..*$|^webpack\.config\..*$|\.sql$|\.bak$|\.backup$|\.old$|\.zip$|\.tar$|\.gz$|\.log$|^README\.md$|^Readme\.txt$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

# Headers basicos de seguridad. No se agrega CSP estricta en esta fase para no romper
# Google Fonts, Google Maps, scripts locales, BootstrapMade ni futuras integraciones.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
</IfModule>

# Cache basica para assets estaticos. HTML/PHP queda sin cache agresiva.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
</IfModule>

# Compresion opcional si mod_deflate esta disponible.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
